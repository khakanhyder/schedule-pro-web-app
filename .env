# PostgreSQL Database (Neon/Supabase/Railway/etc)
# For development, you can use a placeholder or set up a real database
# DATABASE_URL=postgresql://user:password@localhost:5432/schedulepro

# Stripe Keys (optional - only if using payments)
STRIPE_SECRET_KEY=sk_test_placeholder
VITE_STRIPE_PUBLIC_KEY=pk_test_placeholder

# Email Service (optional - only if using emails)
RESEND_API_KEY=re_placeholder

# Session Secret (generate a secure random string)
SESSION_SECRET=your_very_secure_session_secret_here_for_development

# Node Environment
NODE_ENV=development

# Port (optional, defaults to 5000)
PORT=5000